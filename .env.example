# LLM Configuration
# Choose one: groq, openai, local
LLM_PROVIDER=groq

# Groq API Key (get free at https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here

# Optional: OpenAI API Key
# OPENAI_API_KEY=your_openai_api_key_here

# Optional: Local LLM with Ollama (http://localhost:11434)
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=mistral

# Qdrant Configuration
QDRANT_HOST=localhost
QDRANT_PORT=6333

# Collections
COLLECTION_TEXT=wiki_text_poc
COLLECTION_IMAGE=wiki_image_poc

# Agent Parameters
MAX_TOKENS=1024
TEMPERATURE=0.7
TOP_K_RETRIEVAL=3
